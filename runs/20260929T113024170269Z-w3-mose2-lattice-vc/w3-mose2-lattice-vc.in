&CONTROL
   calculation      = 'vc-relax'
   nstep            = 100
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './scratch'
   prefix           = 'w3_mose2_lattice_vc'
   etot_conv_thr    = 1e-06
   forc_conv_thr    = 0.0001
   pseudo_dir       = './pseudo'
/
&SYSTEM
   ecutwfc          = 120
   ecutrho          = 480
   occupations      = 'fixed'
   nspin            = 1
   input_dft        = 'vdw-df-c09'
   ntyp             = 2
   nat              = 3
   ibrav            = 0
/
&ELECTRONS
   electron_maxstep = 200
   conv_thr         = 1e-10
   mixing_beta      = 0.4
/
&IONS
   ion_dynamics     = 'bfgs'
/
&CELL
   cell_dynamics    = 'bfgs'
   press            = 0.0
   press_conv_thr   = 0.1
   cell_dofree      = '2Dxy'
/
&FCP
/
&RISM
/
ATOMIC_SPECIES
Mo 95.95 Mo.upf
Se 78.971 Se.upf

K_POINTS automatic
12 12 1  0 0 0

CELL_PARAMETERS angstrom
