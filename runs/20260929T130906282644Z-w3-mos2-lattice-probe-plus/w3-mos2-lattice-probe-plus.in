&CONTROL
   calculation      = 'scf'
   nstep            = 100
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './scratch'
   prefix           = 'w3_mos2_lattice_probe_plus'
   etot_conv_thr    = 1e-06
   forc_conv_thr    = 0.0001
   pseudo_dir       = './pseudo'
/
&SYSTEM
   ecutwfc          = 120
   ecutrho          = 480
   occupations      = 'fixed'
   nspin            = 1
   input_dft        = 'vdw-df-c09'
   ntyp             = 2
   nat              = 3
   ibrav            = 0
/
&ELECTRONS
   electron_maxstep = 200
   conv_thr         = 1e-10
   mixing_beta      = 0.4
/
&IONS
/
&CELL
/
&FCP
/
&RISM
/
