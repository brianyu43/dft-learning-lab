&CONTROL
   calculation      = 'relax'
   nstep            = 100
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './scratch'
   prefix           = 'w3_mos2_common_lattice_relax'
   etot_conv_thr    = 1e-06
   forc_conv_thr    = 0.0001
   pseudo_dir       = './pseudo'
/
&SYSTEM
   ecutwfc          = 100
   ecutrho          = 400
   occupations      = 'fixed'
   nspin            = 1
   input_dft        = 'vdw-df-c09'
   ntyp             = 2
   nat              = 3
   ibrav            = 0
/
&ELECTRONS
   electron_maxstep = 200
   conv_thr         = 1e-10
   mixing_beta      = 0.4
/
&IONS
   ion_dynamics     = 'bfgs'
/
&CELL
/
&FCP
/
&RISM
/
ATOMIC_SPECIES
Mo 95.95 Mo.upf
S 32.06 S.upf

K_POINTS automatic
9 9 1  0 0 0

