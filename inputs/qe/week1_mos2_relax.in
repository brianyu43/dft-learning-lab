&CONTROL
   calculation      = 'relax'
   nstep            = 80
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './scratch'
   prefix           = 'week1_mos2'
   etot_conv_thr    = 1e-06
   forc_conv_thr    = 0.0003
   pseudo_dir       = './pseudo'
/
&SYSTEM
   ecutwfc          = 80.0
   ecutrho          = 320.0
   nosym            = .false.
   occupations      = 'fixed'
   nspin            = 1
   input_dft        = 'vdw-df-c09'
   ntyp             = 2
   nat              = 3
   ibrav            = 0
/
&ELECTRONS
   electron_maxstep = 150
   conv_thr         = 1e-08
   mixing_beta      = 0.4
/
&IONS
   ion_dynamics     = 'bfgs'
/
&CELL
/
&FCP
/
&RISM
/
