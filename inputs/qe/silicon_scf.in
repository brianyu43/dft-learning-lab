! Installation test ONLY: coarse k-grid and cutoff, not a converged materials result.
&CONTROL
  calculation = 'scf'
  prefix = 'si_smoke'
  pseudo_dir = './pseudo'
  outdir = './scratch'
/
&SYSTEM
  ibrav = 2
  A = 5.43
  nat = 2
  ntyp = 1
  ecutwfc = 30.0
  ecutrho = 120.0
  occupations = 'fixed'
/
&ELECTRONS
  conv_thr = 1.0d-8
  electron_maxstep = 100
  mixing_beta = 0.7
/
ATOMIC_SPECIES
Si 28.085 Si_ONCV_PBE-1.1.upf
ATOMIC_POSITIONS alat
Si 0.00 0.00 0.00
Si 0.25 0.25 0.25
K_POINTS automatic
2 2 2 0 0 0
